# Copy to .env and adjust. Used by docker-compose and local dev.

# Postgres (the compose `db` service is initialized with these)
# POSTGRES_PASSWORD is required — compose aborts if it's unset. Use a strong value.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# better-auth — MUST be >=32 chars of high entropy (openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public base URL of the app. Behind an HTTPS reverse proxy this MUST be your
# public https:// URL — otherwise better-auth issues session cookies without the
# Secure flag and sign-in fails with INVALID_ORIGIN.
BETTER_AUTH_URL=http://localhost:3000

# Host port for the web container (container always listens on 3000)
WEB_PORT=3000

# Allow new account creation. Set to "false" to lock signup (e.g. after you've
# created your own account). Enforced server-side in better-auth.
ALLOW_SIGNUP=true

# Reverse-proxy hops in front of the app, for rate-limit client-IP detection.
#   false (default) — direct exposure: X-Forwarded-For is ignored (it's
#     client-forgeable) and anonymous traffic shares one bucket.
#   true / a number — you run N trusted proxies (nginx/caddy/traefik) that strip
#     inbound XFF and append a trustworthy entry; the IP is read that many hops
#     from the right. Set this when behind a proxy so per-IP throttling works.
TRUST_PROXY=false

# Collector self-update. The release repo is private, so the server is the only
# thing holding a GitHub credential: it proxies release assets to devices that
# authenticate with their own device token. Needs a token with `contents: read`
# on the repo (a fine-grained PAT is enough). Leave unset to disable updates —
# collectors treat the 503 as "nothing to do".
# GITHUB_TOKEN=github_pat_xxx
# GITHUB_REPO=rokartur/usagefleet

# Stripe billing. An account's device cap IS its plan (free = 1 device,
# Solo = 2, Fleet = 8), so all four are required in production — the app throws
# on boot without them. Create two recurring monthly prices ($1 and $3) in
# Stripe and paste their price ids here. Webhook endpoint:
#   <BETTER_AUTH_URL>/api/auth/stripe/webhook
# subscribed to checkout.session.completed, customer.subscription.updated and
# customer.subscription.deleted.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_SOLO=price_xxx
STRIPE_PRICE_FLEET=price_xxx

# For LOCAL (non-docker) dev only — points at a Postgres you run yourself:
# DATABASE_URL=postgresql://app:app@localhost:5432/app
