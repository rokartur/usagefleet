# Copy to .env and adjust. Used by docker-compose and local dev.

# Postgres (the compose `db` service is initialized with these)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# better-auth — MUST be >=32 chars of high entropy (openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public base URL of the app (browser-facing). Build arg + runtime.
# Behind an HTTPS reverse proxy this MUST be your public https:// URL — otherwise
# better-auth issues session cookies without the Secure flag and sign-in fails
# with INVALID_ORIGIN.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Host port for the web container (container always listens on 3000)
WEB_PORT=3000

# Allow new account creation. Set to "false" to lock signup (e.g. after you've
# created your own account). Enforced server-side in better-auth.
ALLOW_SIGNUP=true

# For LOCAL (non-docker) dev only — points at a Postgres you run yourself:
# DATABASE_URL=postgresql://app:app@localhost:5432/app
