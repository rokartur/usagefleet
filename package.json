{
  "name": "usagefleet",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env run --filter web dev",
    "build": "bun --env-file=.env run --filter web build",
    "start": "bun --env-file=.env run --filter web start",
    "test": "bun run --filter '*' test",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "bun --env-file=.env run --filter web db:generate",
    "db:studio": "bun --env-file=.env run --filter web db:studio",
    "db:migrate": "bun --env-file=.env run --filter web db:migrate"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  },
  "packageManager": "bun@1.3.14"
}
