{
	"name": "@usagefleet/cli",
	"version": "1.2.84",
	"description": "Tails Claude Code, Claude Desktop, and pi agent JSONL logs and reports token usage to a UsageFleet server.",
	"keywords": [
		"claude",
		"claude-code",
		"telemetry",
		"tokens",
		"usage"
	],
	"homepage": "https://usagefleet.com",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rokartur/usagefleet.git",
		"directory": "apps/cli"
	},
	"bin": {
		"usagefleet": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"dev": "bun run src/index.ts",
		"start": "node dist/index.js",
		"test": "vitest run",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^24",
		"typescript": "^7",
		"vitest": "^4"
	},
	"engines": {
		"node": ">=20"
	}
}
