{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": false,
		"types": ["node"]
	},
	"include": ["src"],
	"exclude": ["dist", "node_modules", "src/**/*.test.ts"]
}
