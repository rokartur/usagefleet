{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // drizzle/** is generated by drizzle-kit, .output/.nitro are vite build
  // artifacts, routeTree.gen.ts is generated by the router plugin; markdown is
  // left alone so docs don't churn on every format run.
  "ignorePatterns": [
    "**/drizzle/**",
    "**/dist/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/routeTree.gen.ts",
    "**/*.md"
  ]
}
