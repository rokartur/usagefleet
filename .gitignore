# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (bun workspaces hoist to the root, but keep per-app safe too)
node_modules

# testing
/coverage

# vite / tanstack start build output
apps/web/.output/
apps/web/.nitro/
apps/web/.tanstack/
apps/web/src/routeTree.gen.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# cli build artifacts + local state
apps/cli/dist
.usagefleet-state.json

# bundled migrator (built inside the Docker image)
apps/web/migrate.cjs

# vercel
.vercel

# typescript
*.tsbuildinfo

# bun.lock is the lockfile; an npm one makes npm reconcile node_modules and break CI
package-lock.json
