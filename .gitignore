# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# collector build artifacts + local state
/collector/node_modules
/collector/dist
.claude-track-state.json

# bundled migrator (built inside the Docker image)
/migrate.cjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
