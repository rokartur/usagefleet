**/.output
**/.nitro
**/.tanstack
**/out
**/dist
**/*.tsbuildinfo
**/migrate.cjs
.git
.gitignore
docker-compose*
.dockerignore
.env
.env.*
*.md
apps/*/*.md
.vscode
.idea
.github
